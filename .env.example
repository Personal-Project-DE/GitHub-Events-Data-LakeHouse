# MinIO Configuration
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=password123
MINIO_PORT=9010
MINIO_CONSOLE_PORT=9011
MINIO_ENDPOINT=http://minio:9000
MINIO_HOST_ENDPOINT=http://localhost:9010

# S3 / MinIO Credentials for Spark, Iceberg REST, and Trino
AWS_ACCESS_KEY_ID=admin
AWS_SECRET_ACCESS_KEY=password123
AWS_REGION=us-east-1

# Apache Iceberg REST Catalog
REST_CATALOG_PORT=8181
REST_CATALOG_URI=http://iceberg-rest:8181
REST_CATALOG_HOST_URI=http://localhost:8181
ICEBERG_WAREHOUSE_LOCATION=s3a://lakehouse/warehouse

# Spark Configuration
SPARK_MASTER_PORT=7077
SPARK_WEBUI_PORT=8088

# Trino Configuration
TRINO_PORT=8082

# Airflow Configuration
AIRFLOW_IMAGE_NAME=apache/airflow:2.10.5-python3.10
AIRFLOW_UID=50000
AIRFLOW_PORT=8085

# Metabase Configuration
METABASE_PORT=3000
